<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets Android 16 promote the agents-at-work card to a Live Update. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application>
        <!-- FCM targets this install by its Firebase Installation ID (onRegistered). -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <!-- Nothing reaches Google until notifications are allowed (FcmPushTokens.register). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <service
            android:name=".LpmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".AnswerReceiver"
            android:exported="false" />
        <receiver
            android:name=".LiveDismissedReceiver"
            android:exported="false" />
    </application>

</manifest>
