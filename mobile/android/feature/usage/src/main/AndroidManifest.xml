<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Lends the weekly recap image to the app it's shared with. -->
        <provider
            android:name="cx.lpm.mobile.feature.usage.recap.RecapImageProvider"
            android:authorities="${applicationId}.recap"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/recap_image_paths" />
        </provider>
        <receiver
            android:name="cx.lpm.mobile.feature.usage.widget.TokenActivityWidgetReceiver"
            android:exported="true"
            android:label="@string/token_activity_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/token_activity_widget" />
        </receiver>
        <receiver
            android:name="cx.lpm.mobile.feature.usage.widget.UsageWidgetReceiver"
            android:exported="true"
            android:label="@string/usage_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/usage_widget" />
        </receiver>
    </application>
</manifest>
